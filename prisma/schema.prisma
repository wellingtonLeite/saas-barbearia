// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  SUPER_ADMIN
  OWNER
  BARBER
  CLIENT
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIAL
}

enum EmploymentType {
  CLT
  COMMISSION_ONLY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  CANCELLED
  COMPLETED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SERVICE
  PRODUCT_SALE
  RENT
  UTILITIES
  PAYROLL
  COMMISSION_PAYOUT
  OTHER
}

enum NotificationType {
  SUBSCRIPTION_EXPIRING
  LOW_STOCK
  NEW_APPOINTMENT
  APPOINTMENT_CANCELLED
  SYSTEM_ALERT
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model Plan {
  id                   String         @id @default(uuid())
  name                 String
  base_price           Decimal
  max_units            Int
  max_barbers          Int            @default(999)
  has_whatsapp         Boolean        @default(false)
  has_financial_module Boolean        @default(false)
  extra_unit_price     Decimal        @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  subscriptions    Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  current_period_end DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  logo_url   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscription  Subscription?
  units         Unit[]
  services      Service[]
  appointments  Appointment[]
  products      Product[]
  sales         Sale[]
  transactions  Transaction[]
  notifications Notification[]
  reviews       Review[]
  schedule_blocks ScheduleBlock[]
}

model Unit {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  phone         String?
  working_hours Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barbers       BarberUnit[]
  contracts     BarberContract[]
  appointments  Appointment[]
  products      Product[]
  transactions  Transaction[]
  schedule_blocks ScheduleBlock[]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role     @default(CLIENT)
  name          String
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units                BarberUnit[]
  contracts            BarberContract[]
  barber_appointments  Appointment[] @relation("BarberAppointments")
  client_appointments  Appointment[] @relation("ClientAppointments")
  barber_sales         Sale[]        @relation("BarberSales")
  client_sales         Sale[]        @relation("ClientSales")
  notifications        Notification[]
  barber_reviews       Review[]      @relation("BarberReviews")
  client_reviews       Review[]      @relation("ClientReviews")
  schedule_blocks      ScheduleBlock[]
}

model BarberUnit {
  barberId  String
  barber    User     @relation(fields: [barberId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())

  @@id([barberId, unitId])
}

model BarberContract {
  id                      String         @id @default(uuid())
  barberId                String
  barber                  User           @relation(fields: [barberId], references: [id], onDelete: Cascade)
  unitId                  String
  unit                    Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employment_type         EmploymentType @default(COMMISSION_ONLY)
  fixed_salary            Decimal        @default(0)
  service_commission_rate Decimal        @default(0) // percentage
  product_commission_rate Decimal        @default(0) // percentage
  working_hours           Json?          // Barber's availability schedule
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@unique([barberId, unitId])
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  barberId  String
  barber    User     @relation(fields: [barberId], references: [id], onDelete: Cascade)
  start_time DateTime
  end_time   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model Service {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  price            Decimal
  duration_minutes Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId            String
  unit              Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  barberId          String
  barber            User              @relation("BarberAppointments", fields: [barberId], references: [id])
  clientId          String
  client            User              @relation("ClientAppointments", fields: [clientId], references: [id])
  serviceId         String
  service           Service           @relation(fields: [serviceId], references: [id])
  start_time        DateTime
  end_time          DateTime
  status            AppointmentStatus @default(PENDING)
  barber_commission Decimal           @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  review            Review?
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name           String
  price          Decimal
  stock_quantity Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements StockMovement[]
}

model StockMovement {
  id        String            @id @default(uuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  reason    String?
  date      DateTime          @default(now())
}

model Sale {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barberId          String?
  barber            User?    @relation("BarberSales", fields: [barberId], references: [id])
  clientId          String?
  client            User?    @relation("ClientSales", fields: [clientId], references: [id])
  total_amount      Decimal
  barber_commission Decimal  @default(0)
  description       String?
  createdAt         DateTime @default(now())
}

model Transaction {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?               @relation(fields: [unitId], references: [id])
  type        TransactionType
  category    TransactionCategory
  amount      Decimal
  description String?
  date        DateTime            @default(now())
  createdAt   DateTime            @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  is_read   Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Review {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barberId      String
  barber        User        @relation("BarberReviews", fields: [barberId], references: [id], onDelete: Cascade)
  clientId      String
  client        User        @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)
  rating        Int         // 1 a 5
  comment       String?
  createdAt     DateTime    @default(now())
}
