{
  "name": "SDR Multi-Tenant (Evolution API + SaaS Context + Groq)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution-webhook",
        "options": {}
      },
      "id": "1",
      "name": "Webhook (Evolution)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "evolution-webhook"
    },
    {
      "parameters": {
        "url": "https://SEU_DOMINIO.com/api/sdr/context",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "instance",
              "value": "={{ $json.body.instance }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Get Context (SaaS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer SUA_CHAVE_API_GROQ"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3-70b-8192\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"{{ $json.data.context }}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $('Webhook (Evolution)').item.json.body.data.message.conversation }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "3",
      "name": "Groq LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook (Evolution)').item.json.body.server_url }}/message/sendText/{{ $('Webhook (Evolution)').item.json.body.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Webhook (Evolution)').item.json.body.apikey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Webhook (Evolution)').item.json.body.data.key.remoteJid }}\",\n  \"text\": \"{{ $json.choices[0].message.content }}\"\n}",
        "options": {}
      },
      "id": "4",
      "name": "Send Reply (Evolution)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Webhook (Evolution)": {
      "main": [
        [
          {
            "node": "Get Context (SaaS)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Context (SaaS)": {
      "main": [
        [
          {
            "node": "Groq LLM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq LLM": {
      "main": [
        [
          {
            "node": "Send Reply (Evolution)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
